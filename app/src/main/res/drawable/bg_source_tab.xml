<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 当前线路 + 焦点 -->
    <item android:state_selected="true" android:state_focused="true">
        <shape>
            <solid android:color="@color/accent" />
            <stroke android:width="2dp" android:color="@android:color/white" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <!-- 当前线路 -->
    <item android:state_selected="true">
        <shape>
            <solid android:color="@color/accent_dark" />
            <stroke android:width="1dp" android:color="@color/accent" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <!-- 遥控器焦点 -->
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/surface_focused" />
            <stroke android:width="2dp" android:color="@color/accent" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="#22343F" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
