<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/backButton"
                android:layout_width="82dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_option"
                android:stateListAnimator="@null"
                android:text="返回"
                android:textColor="@color/text_primary" />

            <EditText
                android:id="@+id/searchInput"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:hint="输入片名、演员或导演"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="17sp" />

            <Button
                android:id="@+id/qrButton"
                android:layout_width="76dp"
                android:layout_height="42dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_option"
                android:stateListAnimator="@null"
                android:text="扫码"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <Button
                android:id="@+id/searchButton"
                android:layout_width="100dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_button"
                android:stateListAnimator="@null"
                android:text="搜索"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/resultTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="6dp"
            android:paddingTop="14dp"
            android:paddingBottom="8dp"
            android:text="搜索你喜爱的影片"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/sourceFilterList"
                android:layout_width="136dp"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:padding="4dp"
                android:visibility="gone" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/resultList"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:padding="4dp" />

                <ProgressBar
                    android:id="@+id/progressBar"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:indeterminateTint="@color/accent"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/stateText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:padding="18dp"
                    android:text="支持片名、演员和导演搜索"
                    android:textColor="@color/text_secondary"
                    android:textSize="16sp" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/qrPanel"
        android:layout_width="420dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_card"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="22dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="手机扫码推送搜索"
            android:textColor="@color/text_primary"
            android:textSize="19sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/qrImage"
            android:layout_width="240dp"
            android:layout_height="240dp"
            android:layout_marginTop="14dp"
            android:background="@android:color/white"
            android:contentDescription="扫码推送二维码"
            android:padding="8dp"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/qrUrlText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textColor="@color/accent"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="手机与电视需在同一局域网，扫码后输入关键词即可推送到电视搜索"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <Button
            android:id="@+id/qrCloseButton"
            android:layout_width="120dp"
            android:layout_height="42dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_option"
            android:stateListAnimator="@null"
            android:text="关闭"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />
    </LinearLayout>
</FrameLayout>
